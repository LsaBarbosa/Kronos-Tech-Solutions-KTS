# Observability Stack Environment Configuration
# Copy this file to .env and update values for your environment
# WARNING: Never commit .env file with real credentials!

# Application environment (local, dev, staging, prod)
APP_ENV=production

# Directory for application logs
KRONOS_LOG_DIR=/var/log/kronos
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.10

# Imagens aprovadas e imutáveis neste ambiente de produção
PROMETHEUS_IMAGE=prom/prometheus@sha256:e4254400b85610324913f0dc4acf92603d9984e7519414c5a12811aa6146acc3
LOKI_IMAGE=grafana/loki@sha256:191d4fdfb7264f16989f0a57f320872620a5a7c2ceeec6229212c4190ec49b86
PROMTAIL_IMAGE=grafana/promtail@sha256:6cfa64ec432b24a912d640e2edb940eeae2666f61861a66c121d763dd7241381
TEMPO_IMAGE=grafana/tempo@sha256:4b0277a9b572a4b1fa43b01468e58911ec214dd69d033f2cd476596d14de9fe3
GRAFANA_IMAGE=grafana/grafana@sha256:2d1f9ae67c1778d33e291d4c3c759cd8b650e67491f02533499eb950e075eeb5

# Grafana Admin Credentials
# IMPORTANT: Change these default credentials in production!
GRAFANA_ADMIN_USER=change-me-grafana-user
GRAFANA_ADMIN_PASSWORD=change-me-strong-grafana-password
GF_SERVER_ROOT_URL=https://observability.kronostechsolutions.com

# SMTP usado pelo Grafana Alerting
GRAFANA_SMTP_HOST=smtp.example.com:587
GRAFANA_SMTP_USER=alerts@example.com
GRAFANA_SMTP_PASSWORD=change-me-smtp-password
GRAFANA_SMTP_FROM_ADDRESS=alerts@example.com
GRAFANA_SMTP_FROM_NAME=Kronos Observability
GRAFANA_SMTP_STARTTLS_POLICY=MandatoryStartTLS
GRAFANA_ALERT_EMAIL_TO=oncall@example.com

# Optional: Prometheus configuration
PROMETHEUS_RETENTION=30d
# PROMETHEUS_SCRAPE_INTERVAL=15s

# Optional: Loki configuration
# LOKI_RETENTION_DAYS=7
