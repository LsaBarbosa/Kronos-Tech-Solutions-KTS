{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\"}[1m]))",
          "legendFormat": "rpm"
        }
      ],
      "title": "Requests por minuto",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\",status=~\"4..\"}[5m]))",
          "legendFormat": "4xx"
        },
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\",status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ],
      "title": "Erros HTTP",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{application=~\"$application\",environment=~\"$environment\"}[5m])) / sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\"}[5m]))",
          "legendFormat": "latencia media"
        }
      ],
      "title": "Latencia media",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "max(http_server_requests_seconds_max{application=~\"$application\",environment=~\"$environment\"})",
          "legendFormat": "p95"
        }
      ],
      "title": "Latencia maxima observada",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "topk(10, sum(rate(http_server_requests_seconds_sum{application=~\"$application\",environment=~\"$environment\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{application=~\"$application\",environment=~\"$environment\"}[5m])) by (uri))",
          "legendFormat": "{{uri}}"
        }
      ],
      "title": "Endpoints mais lentos",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "kronos-backend", "value": "kronos-backend" },
        "name": "application",
        "query": "label_values(http_server_requests_seconds_count, application)",
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "production", "value": "production" },
        "name": "environment",
        "query": "label_values(http_server_requests_seconds_count, environment)",
        "type": "query"
      }
    ]
  },
  "title": "KRONOS API",
  "uid": "kronos-api"
}
