{
  "id": null,
  "uid": "kronos-legal-documents",
  "title": "Kronos Legal Documents",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Legal Generation Totals",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kronos_legal_generation_total[5m])) by (legal_document_type, result)",
          "legendFormat": "{{legal_document_type}} {{result}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Document Operations",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(kronos_document_operation_total[5m])) by (operation, document_type, result)",
          "legendFormat": "{{operation}} {{document_type}} {{result}}"
        }
      ]
    }
  ]
}
