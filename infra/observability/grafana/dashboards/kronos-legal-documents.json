{
  "id": null,
  "uid": "kronos-legal-documents",
  "title": "Kronos Legal Documents",
  "tags": [],
  "style": "dark",
  "timezone": "browser",
  "refresh": "5m",
  "schemaVersion": 27,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Consent Activity",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(kronos_consent_accepted_total{application=\"kronos-backend\",environment=\"production\"}[1h])",
          "legendFormat": "Accepted"
        },
        {
          "refId": "B",
          "expr": "increase(kronos_consent_revoked_total{application=\"kronos-backend\",environment=\"production\"}[1h])",
          "legendFormat": "Revoked"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Consents Accepted Total",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "kronos_consent_accepted_total{application=\"kronos-backend\",environment=\"production\"} or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Consents Revoked Total",
      "datasource": "Prometheus",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "kronos_consent_revoked_total{application=\"kronos-backend\",environment=\"production\"} or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Password Reset Tokens Created",
      "datasource": "Prometheus",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "expr": "kronos_redis_reset_token_total{application=\"kronos-backend\",environment=\"production\"} or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "External API Requests",
      "datasource": "Prometheus",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(kronos_external_provider_request_total{application=\"kronos-backend\",environment=\"production\"}[5m])",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "External API Latency",
      "datasource": "Prometheus",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(kronos_external_provider_request_duration_seconds_sum{application=\"kronos-backend\",environment=\"production\"}[5m]) / rate(kronos_external_provider_request_duration_seconds_count{application=\"kronos-backend\",environment=\"production\"}[5m])",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
