{
  "id": null,
  "uid": "kronos-jvm-postgres",
  "title": "Kronos JVM & Postgres",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM Heap Used",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"kronos-backend\",area=\"heap\"})",
          "legendFormat": "heap"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Hikari Active Connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=\"kronos-backend\"}",
          "legendFormat": "active"
        }
      ]
    }
  ]
}
