{
  "id": null,
  "uid": "kronos-jvm",
  "title": "KRONOS JVM",
  "schemaVersion": 27,
  "version": 1,
  "style": "dark",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h", "2h", "1d"]
  },
  "timezone": "browser",
  "tags": ["jvm", "kronos"],
  "editable": true,
  "graphTooltip": 0,
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "JVM Heap Usage",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 10,
            "gradientMode": "none",
            "spanNulls": false,
            "showPoints": "auto",
            "pointSize": 5,
            "barAlignment": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "tooltip": { "mode": "single" },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"kronos-backend\", environment=\"production\", area=\"heap\"}",
          "legendFormat": "Used Heap",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_max_bytes{application=\"kronos-backend\", environment=\"production\", area=\"heap\"}",
          "legendFormat": "Max Heap",
          "refId": "B"
        },
        {
          "expr": "jvm_memory_committed_bytes{application=\"kronos-backend\", environment=\"production\", area=\"heap\"}",
          "legendFormat": "Committed Heap",
          "refId": "C"
        }
      ]
    },
