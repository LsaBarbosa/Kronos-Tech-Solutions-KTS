#!/usr/bin/env sh
# Pre-commit hook: Validate no secrets are committed

set -e

echo "🔐 Running pre-commit security checks..."

# Check 1: Run gitleaks on staged files (if installed)
if command -v gitleaks &>/dev/null; then
  echo "  ⚡ Scanning for secrets with gitleaks..."
  if gitleaks protect --staged --config .gitleaks.toml --exit-code 0 2>/dev/null; then
    echo "  ✓ No secrets detected"
  else
    echo "  ✗ Gitleaks found potential secrets!"
    exit 1
  fi
else
  echo "  ℹ gitleaks not installed — skipping (will run in CI)"
fi

# Check 2: Run local secret scanner
if [ -f "scripts/security/assert-no-secrets.sh" ]; then
  echo "  ⚡ Running assert-no-secrets.sh..."
  bash scripts/security/assert-no-secrets.sh || {
    echo "  ✗ Secret scan failed"
    exit 1
  }
fi

echo "✓ Pre-commit checks passed"
exit 0
