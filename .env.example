# ===============================================
# KRONOS BACKEND - Environment Variables Example
# ===============================================
# DO NOT put real secrets here.
# Copy this file to /etc/kronos/kronos-backend.env on production server.
# For local development, copy to .env.local (not tracked by git)
# ===============================================

# ==================
# Spring & Server
# ==================
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_NAME=kronos-backend
APP_ENV=prod

# ==================
# Database (PostgreSQL)
# ==================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kronos_prod
DB_USERNAME=kronos_user
DB_PASSWORD=change-me-strong-password

# Connection pool
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_INITIALIZATION_FAIL_TIMEOUT_MS=10000
DB_CONNECT_TIMEOUT_SECONDS=10
DB_SOCKET_TIMEOUT_SECONDS=15

# ==================
# JPA / Hibernate / Flyway
# ==================
JPA_DDL_AUTO=validate
JPA_QUERY_TIMEOUT_MS=10000
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# ==================
# JWT Security
# ==================
JWT_SECRET=change-me-use-base64-encoded-secret-at-least-64-chars
JWT_EXPIRATION=900000

# ==================
# Biometric Security
# ==================
# SECRET_TERM is used as a salt for biometric term hashing.
# Generate with: openssl rand -base64 48
SECRET_TERM=change-me-use-a-strong-random-value-at-least-32-chars

# ==================
# Frontend URLs
# ==================
FRONTEND_BASE_URL_PLATAFORM=https://api.kronossolutions.tech
FRONTEND_BASE_URL_RECORD=https://app.kronossolutions.tech
FRONTEND_BASE_URL_LOCAL=https://kronossolutions.tech
FRONTEND_BASE_URL_LOCAL_2=https://www.kronossolutions.tech
FRONTEND_ALLOWED_ORIGINS=https://kronossolutions.tech,https://www.kronossolutions.tech,https://app.kronossolutions.tech

# ==================
# Email / SMTP
# ==================
MAIL_HOST=smtp.seu-provedor.com
MAIL_PORT=587
MAIL_USERNAME=noreply@kronossolutions.tech
MAIL_PASSWORD=change-me-smtp-password
MAIL_SMTP_DEBUG=false
MAIL_SMTP_CONNECTION_TIMEOUT=5000
MAIL_SMTP_TIMEOUT=5000
MAIL_SMTP_WRITE_TIMEOUT=5000
MANAGEMENT_HEALTH_MAIL_ENABLED=true

# ==================
# AWS Configuration
# ==================
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=change-me-aws-access-key
AWS_SECRET_ACCESS_KEY=change-me-aws-secret-key
AWS_S3_BUCKET_NAME=kronos-prod-documents
AWS_S3_BUCKET_NAME_DOCS=kronos-prod-docs-legal
AWS_REKOGNITION_COLLECTION_ID=kronos_prod

# ==================
# File Storage
# ==================
# Use this only if local file storage is enabled.
# If production uses S3/bucket, this path may not be used by the active storage provider.
FILE_STORAGE_ROOT_PATH=/opt/kronos/documents

# ==================
# HERE Geolocation (Optional)
# ==================
HERE_BASE_URL=https://geocode.search.hereapi.com
HERE_API_KEY=change-me-here-api-key

# ==================
# Security - Auth Cookie
# ==================
AUTH_COOKIE_NAME=KRONOS_ACCESS_TOKEN
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=kronossolutions.tech
AUTH_COOKIE_MAX_AGE_SECONDS=900

# ==================
# Security - Rate Limiting
# ==================
LOGIN_RATE_LIMIT_IP_LIMIT=10
LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_USERNAME_LIMIT=5
LOGIN_RATE_LIMIT_USERNAME_WINDOW_SECONDS=300
LOGIN_RATE_LIMIT_COOLDOWN_MINUTES=5,15,30

RECOVERY_RATE_LIMIT_CPF_LIMIT=3
RECOVERY_RATE_LIMIT_EMAIL_LIMIT=3
RECOVERY_RATE_LIMIT_IP_LIMIT=10
RECOVERY_RATE_LIMIT_WINDOW_SECONDS=3600

# ==================
# Security - Digital Certificate (Optional, for electronic signature)
# ==================
DIGITAL_CERTIFICATE_PATH=/etc/kronos/certs/certificate.p12
DIGITAL_CERTIFICATE_PASSWORD=change-me-certificate-password

# ==================
# Security - Biometric
# ==================
BIOMETRIC_MAX_BASE64_CHARS=1500000
BIOMETRIC_LIVENESS_REQUIRED=false

BIOMETRIC_LOGIN_FACE_LIMIT=5
BIOMETRIC_LOGIN_FACE_WINDOW_SECONDS=60

BIOMETRIC_CHECKIN_LIMIT=20
BIOMETRIC_CHECKIN_WINDOW_SECONDS=60

BIOMETRIC_ENROLLMENT_LIMIT=10
BIOMETRIC_ENROLLMENT_WINDOW_SECONDS=600

# ==================
# Upload Configuration
# ==================
UPLOAD_MAX_BYTES=5242880
UPLOAD_ANTIVIRUS_ENABLED=false
UPLOAD_ANTIVIRUS_HOST=localhost
UPLOAD_ANTIVIRUS_PORT=3310
UPLOAD_ANTIVIRUS_TIMEOUT_MS=3000

# ==================
# Logging
# ==================
LOGPATTERN_CONSOLE=%green(%d{HH:mm:ss.SSS}) %blue(%-5level) %red([%thread]) %yellow(%logger{15}) - %msg%n
SPRING_SECURITY_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=WARN
KRONOS_LOG_DIR=./logs/kronos
# Optional Spring profile to also write structured JSON logs to file
# SPRING_PROFILES_INCLUDE=file-logs

# ==================
# Actuator / Monitoring
# ==================
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE=health,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Front-end observability ingestion
KRONOS_OBSERVABILITY_FRONTEND_EVENTS_ENABLED=true
KRONOS_OBSERVABILITY_FRONTEND_EVENTS_RATE_LIMIT_LIMIT=120
KRONOS_OBSERVABILITY_FRONTEND_EVENTS_RATE_LIMIT_WINDOW_SECONDS=60
KRONOS_OBSERVABILITY_FRONTEND_EVENTS_MAX_PAYLOAD_CHARACTERS=1024

# ==================
# Documentation
# ==================
APP_SECURITY_PUBLIC_DOCS_ENABLED=false

# ==================
# LGPD Compliance
# ==================
# ⚠️ MANDATORY: Production deployment MUST explicitly choose ONE option below.
# These variables MUST NOT be left at default in production.

# Data Retention Scheduler Configuration
# Choose ONE option:
# Option A (Conservative): SCHEDULER_ENABLED=false, ALLOW_APPLY=false
# Option B (Monitoring):   SCHEDULER_ENABLED=true,  ALLOW_APPLY=false
# Option C (Automation):   SCHEDULER_ENABLED=true,  ALLOW_APPLY=true

LGPD_RETENTION_SCHEDULER_ENABLED=false
LGPD_RETENTION_SCHEDULER_CRON=0 15 4 * * ?
LGPD_RETENTION_ALLOW_APPLY=false

# Production Deployment Requirement:
# Before deploying to production, fill in the chosen option in DEPLOYMENT-CHECKLIST.md
# Deployment MUST FAIL if these variables are not explicitly configured.
