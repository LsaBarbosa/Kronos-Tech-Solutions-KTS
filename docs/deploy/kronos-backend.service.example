[Unit]
Description=Kronos Backend Service
Documentation=file:///etc/kronos/kronos-backend.env
After=network.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
# Security: Run as non-root user
User=kronos
Group=kronos
NoNewPrivileges=true

# Working directory
WorkingDirectory=/opt/kronos/backend

# Load environment variables from file
EnvironmentFile=/etc/kronos/kronos-backend.env

# Application startup
Type=simple
ExecStart=/usr/bin/java \
  -XX:+UseG1GC \
  -XX:MaxRAMPercentage=75.0 \
  -XX:InitialRAMPercentage=50.0 \
  -XX:MinRAMPercentage=25.0 \
  -XX:+UseStringDeduplication \
  -XX:+ParallelRefProcEnabled \
  -Dspring.profiles.active=prod \
  -jar /opt/kronos/backend/kronos-backend.jar

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Process limits
LimitNOFILE=65536
LimitNPROC=32768

# Sandboxing (security hardening)
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
# ReadWritePaths=/opt/kronos/documents (uncomment if using local file storage instead of S3)

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kronos-backend

# Health check
ExecStartPost=/bin/bash -c 'for i in {1..30}; do sleep 1 && curl -sf http://localhost:8080/actuator/health >/dev/null && break; done'

[Install]
WantedBy=multi-user.target
