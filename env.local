# Banco local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kronos_local
DB_USER=kronos_local
DB_PASSWORD=kronos_local

# JPA/Flyway
JPA_DDL_AUTO=none
FLYWAY_ENABLED=true
FLYWAY_BASELINE_ON_MIGRATE=false

# Segurança local
JWT_SECRET=local-dev-secret-with-at-least-32-characters-kronos
JWT_EXPIRATION=3600000
SECRET_TERM=local-biometric-term-salt
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_MAX_AGE_SECONDS=3600

# Front-end local
FRONTEND_BASE_URL_PLATAFORM=http://localhost:5173
FRONTEND_BASE_URL_RECORD=http://localhost:5173
FRONTEND_BASE_URL_LOCAL=http://localhost:5173
FRONTEND_BASE_URL_LOCAL_2=http://127.0.0.1:5173

# E-mail local/dummy
MAIL_HOST=localhost
MAIL_PORT=2525
MAIL_USERNAME=local
MAIL_PASSWORD=local
MANAGEMENT_HEALTH_MAIL_ENABLED=false

# AWS dummy para subir localmente; só use recursos reais se configurar credenciais válidas.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_S3_BUCKET_NAME=kronos-local
AWS_S3_BUCKET_NAME_DOCS=kronos-local-docs
AWS_REKOGNITION_COLLECTION_ID=kronos-local

# Arquivos locais
FILE_STORAGE_ROOT_PATH=./storage/documents

# Docs locais, opcional
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
APP_SECURITY_PUBLIC_DOCS_ENABLED=true

# Logs locais
SPRING_SECURITY_LOG_LEVEL=INFO
HIBERNATE_SQL_LOG_LEVEL=INFO
