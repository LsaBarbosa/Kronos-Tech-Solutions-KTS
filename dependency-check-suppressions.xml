<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        FALSE POSITIVE — Micrometer Registry Prometheus CPE mismatch.
        CVE-2026-42154 targets the Prometheus *server* (cpe:prometheus:prometheus).
        micrometer-registry-prometheus is a Java metrics exporter, not the server.
    -->
    <suppress>
        <notes>CPE mismatch: micrometer-registry-prometheus is a Java exporter, not the Prometheus server binary.</notes>
        <gav regex="true">^io\.micrometer:micrometer-registry-prometheus:.*$</gav>
        <cve>CVE-2026-42154</cve>
    </suppress>

    <!--
        FALSE POSITIVE — Kotlin stdlib CVE-2020-29582 version range mismatch.
        The CVE affects Kotlin < 1.4.21 (temp file disclosure via insecure Java API).
        Current version 1.9.25 has included the fix since 1.4.21. The NVD CPE range
        is overly broad and incorrectly matches all 1.x releases.
    -->
    <suppress>
        <notes>CVE-2020-29582 fixed in Kotlin 1.4.21; current version 1.9.25 is unaffected. CPE version range mismatch.</notes>
        <gav regex="true">^org\.jetbrains\.kotlin:kotlin-stdlib.*:.*$</gav>
        <cve>CVE-2020-29582</cve>
    </suppress>

    <!--
        NOT APPLICABLE IN PRODUCTION — Swagger UI / DOMPurify.
        springdoc.api-docs.enabled=false and springdoc.swagger-ui.enabled=false in prod and default profiles.
        The swagger-ui JAR is present on the classpath but serves no requests in production.
        Confirmed in security audit round 3 (2026-06-22).
    -->
    <suppress>
        <notes>Swagger UI is disabled in production; DOMPurify XSS CVEs are not reachable at runtime.</notes>
        <filePath regex="true">.*swagger-ui-.*\.jar$</filePath>
    </suppress>

    <!--
        FALSE POSITIVE — opentelemetry-semconv CPE mismatch.
        CVEs CVE-2026-39882, CVE-2026-39883, CVE-2026-24051, CVE-2026-41178 target the
        OpenTelemetry Collector or SDK runtime. opentelemetry-semconv is a read-only
        constants library (semantic convention string definitions) with no network code,
        no deserialization, and no runtime behaviour that these CVEs could exploit.
    -->
    <suppress>
        <notes>opentelemetry-semconv contains only string constants; CVEs target the OTel Collector/SDK runtime, not this artifact.</notes>
        <gav regex="true">^io\.opentelemetry\.semconv:opentelemetry-semconv:.*$</gav>
        <cve>CVE-2026-39882</cve>
    </suppress>
    <suppress>
        <notes>opentelemetry-semconv contains only string constants; CVEs target the OTel Collector/SDK runtime, not this artifact.</notes>
        <gav regex="true">^io\.opentelemetry\.semconv:opentelemetry-semconv:.*$</gav>
        <cve>CVE-2026-39883</cve>
    </suppress>
    <suppress>
        <notes>opentelemetry-semconv contains only string constants; CVEs target the OTel Collector/SDK runtime, not this artifact.</notes>
        <gav regex="true">^io\.opentelemetry\.semconv:opentelemetry-semconv:.*$</gav>
        <cve>CVE-2026-24051</cve>
    </suppress>
    <suppress>
        <notes>opentelemetry-semconv contains only string constants; CVEs target the OTel Collector/SDK runtime, not this artifact.</notes>
        <gav regex="true">^io\.opentelemetry\.semconv:opentelemetry-semconv:.*$</gav>
        <cve>CVE-2026-41178</cve>
    </suppress>

</suppressions>
